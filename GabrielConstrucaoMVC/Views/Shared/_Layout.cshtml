                            <div class="footer-tittle">

                                <h4>Contato</h4>

                                <div class="footer-pera">

                                    <p class="info1">
                                        Av. Arthur Balsi, Nº620.
                                        Barra Bonita, SP.
                                    </p>

                                </div>

                                <ul>

                                    <li>
                                        <a href="https://wa.me/5514997354643" target="_blank">
                                            Telefone: (14) 99735-4643
                                        </a>
                                    </li>

                                    <li>
                                        <a
                                            href="mailto:gabrielconstrucao1@gmail.com?subject=Contato%20pelo%20site%20-%20Gabriel%20Construção">
