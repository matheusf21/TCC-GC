<body>

    <header>
        <!-- Header Start -->
        <div class="header-area header-transparent">
            <div class="main-header">
                <div class="header-bottom header-sticky">
                    <div class="container-fluid">
                        <div class="row align-items-center">

                            <!-- Logo -->
                            <div class="col-xl-2 col-lg-2 col-md-2">
                                <div class="logo">
                                    <a href="/" class="big-logo">
                                        <img src="/assets/img/logo/logo.png" alt="Gabriel Construção">
                                    </a>
                                    <a href="/" class="small-logo">
                                        <img src="/assets/img/logo/loder-logo.png" alt="Gabriel Construção">
                                    </a>
                                </div>
                            </div>

                            <!-- Bloco da Direita (Menu + Redes + Botão) -->
                            <div
                                class="col-xl-10 col-lg-10 col-md-10 d-none d-lg-flex align-items-center justify-content-end">

                                <!-- Menu -->
                                <div class="main-menu mr-4">
                                    <nav>
                                        <ul id="navigation">
                                            <li><a href="/Home/About">Sobre</a></li>
                                            <li><a href="/Home/Products">Produtos</a></li>
                                            <li><a href="/Home/Services">Serviços</a></li>
                                            <li><a href="/Home/PetArea">Área Pet</a></li>
                                        </ul>
                                    </nav>
                                </div>

                                <!-- Redes Sociais -->
                                <div class="header-social-links mr-4">
                                    <a href="https://wa.me/5514997354643" target="_blank" rel="noopener noreferrer"
                                       aria-label="WhatsApp">
                                        <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                    </a>
                                    <a href="https://www.instagram.com/gabri.elconstrucoes?utm_source=ig_web_button_share_sheet&rpxt=ZDNlZDc0MzIxNw==" target="_blank" rel="noopener noreferrer"
                                       aria-label="Instagram">
                                        <i class="fab fa-instagram" aria-hidden="true"></i>
                                    </a>
                                    <a href="https://web.facebook.com/Gabrielconstrucao/?locale=pt_BR&_rdc=1&_rdr#" target="_blank" rel="noopener noreferrer"
                                       aria-label="Facebook">
                                        <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                    </a>
                                </div>

                                <!-- Botão Contato -->
                                <div class="header-right-btn">
                                    <a href="/Home/Contact" class="btn btn-contato">Contato</a>
                                </div>

                            </div>

                            <!-- Mobile Menu -->
                            <div class="col-12">
                                <div class="mobile_menu d-block d-lg-none"></div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Header End -->
    </header>

</header>

@RenderBody()

<!-- Footer Start -->
