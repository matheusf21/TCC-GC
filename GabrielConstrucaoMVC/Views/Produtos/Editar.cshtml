@model GabrielConstrucaoMVC.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-produtos.css" />
}

<div class="pagina-editar-produto">
    <div class="container">

        <h1>Editar Produto</h1>

        <p>Altere os dados do produto.</p>

        <form asp-action="Editar" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <input asp-for="NomeImagem" type="hidden" />

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Area" class="form-label">
                    Área do produto
                </label>

                <select asp-for="Area" class="form-control">
                    <option value="">Selecione uma área</option>
                    <option value="Construção">Construção</option>
                    <option value="Pet">Pet</option>
                </select>

                <span asp-validation-for="Area" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label"></label>
                <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Categoria" class="form-label"></label>

                <select asp-for="Categoria" class="form-control">
                    <option value="">Selecione uma categoria</option>

                    <optgroup label="Construção">
                        <option value="Construção">Construção</option>
                        <option value="Encanamento">Encanamento</option>
                        <option value="Acabamento">Acabamento</option>
                        <option value="Elétrica">Elétrica</option>
                        <option value="Ferramentas">Ferramentas</option>
                    </optgroup>

                    <optgroup label="Área Pet">
                        <option value="Ração">Ração</option>
                        <option value="Acessórios">Acessórios</option>
                        <option value="Higiene">Higiene</option>
                        <option value="Brinquedos">Brinquedos</option>
                    </optgroup>
                </select>

                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Preco" class="form-label">
                    Preço
                </label>

                <input asp-for="Preco" class="form-control" type="text" inputmode="decimal"
                       value="@Model.Preco.ToString("0.00", new System.Globalization.CultureInfo("pt-BR"))" />

                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UnidadeMedida" class="form-label">
                    Unidade de medida
                </label>

                <select asp-for="UnidadeMedida" class="form-control">
                    <option value="">Selecione uma unidade</option>
                    <option value="Unidade">Unidade</option>
                    <option value="Saco">Saco</option>
                    <option value="Caixa">Caixa</option>
                    <option value="Pacote">Pacote</option>
                    <option value="Quilograma">Quilograma</option>
                    <option value="Litro">Litro</option>
                    <option value="Metro">Metro</option>
                    <option value="Metro quadrado">Metro quadrado</option>
                    <option value="Metro cúbico">Metro cúbico</option>
                    <option value="Rolo">Rolo</option>
                    <option value="Lata">Lata</option>
                </select>

                <span asp-validation-for="UnidadeMedida" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Imagem atual</label>

                <div>
                    @if (!string.IsNullOrEmpty(Model.NomeImagem))
                    {
                        <img src="@Url.Content("~/uploads/produtos/" + Model.NomeImagem)" alt="em-produto-atual"
                             class="imagem-produto-atual" />
                    }
                    else
                    {
                        <span>Produto sem imagem.</span>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label for="imagem" class="form-label">Escolher nova imagem</label>

                <input type="file" id="imagem" name="imagem" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            </div>

            <div class="form-check mb-3">
                <input asp-for="MaisVendido" class="form-check-input" />

                <label asp-for="MaisVendido" class="form-check-label">
                    Mais vendido
                </label>
            </div>

            <div class="form-check mb-3">
                <input asp-for="ForaDeEstoque" class="form-check-input" />

                <label asp-for="ForaDeEstoque" class="form-check-label">
                    Fora de estoque
                </label>
            </div>

            <button type="submit" class="btn btn-success">
                Salvar Alterações
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Voltar
            </a>

        </form>

    </div>
</div>
