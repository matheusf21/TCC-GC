@model IEnumerable<GabrielConstrucaoMVC.Models.Produto>
@{
    ViewData["Title"] = "Produtos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<!-- Preloader Start -->
<div id="preloader-active">
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
            <div class="preloader-circle"></div>
            <div class="preloader-img pere-text">
                <img src="/assets/img/logo/loder-logo.png" alt="">
            </div>
        </div>
    </div>
</div>
<!-- Preloader End -->

<main>
    <!-- Banner interno -->
    <div class="slider-area">
        <div class="single-slider hero-overly slider-height2 d-flex align-items-center"
             data-background="/assets/img/banner/bannerprodutos.jpeg">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-cap pt-100">
                            <h2>Nossos Produtos</h2>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item"><a href="#">Produtos</a></li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Seção de produtos com filtros -->
    <section class="products-page section-padding30">
        <div class="container">
            <!-- Filtros e busca -->
            <div class="filter-bar">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="filter-buttons">
                            <button class="btn-filter active" data-filter="all">Todos</button>
                            <button class="btn-filter" data-filter="construcao">Construção</button>
                            <button class="btn-filter" data-filter="encanamento">Encanamento</button>
                            <button class="btn-filter" data-filter="acabamento">Acabamento</button>
                            <button class="btn-filter" data-filter="eletrica">Elétrica</button>
                            <button class="btn-filter" data-filter="ferramentas">Ferramentas</button>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="search-box">
                            <input type="text" id="search-input" placeholder="Buscar produto...">
                            <button id="search-btn"><i class="ti-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Grade de produtos -->
                <div class="col-lg-8">

                    <div class="row" id="products-grid">

                        @if (!Model.Any())
                        {
                            <div class="col-12">
                                <div class="alert alert-info">
                                    Nenhum produto disponível no momento.
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var produto in Model)
                            {
                                var categoriaFiltro = produto.Categoria
                                    .Trim()
                                     .ToLowerInvariant();

                                categoriaFiltro = categoriaFiltro switch
                                {
                                    "construção" => "construcao",
                                    "encanamento" => "encanamento",
                                    "acabamento" => "acabamento",
                                    "elétrica" => "eletrica",
                                    "ferramentas" => "ferramentas",
                                    _ => categoriaFiltro
                                };

                                <div class="col-xl-6 col-lg-6 col-md-6 produto-item" data-categoria="@categoriaFiltro"
                                     data-nome="@produto.Nome.ToLower()">

                                    <div class="single-produto-card mb-30" data-produto-id="@produto.Id"
                                         data-produto-nome="@produto.Nome"
                                         data-produto-preco="@produto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                        <div class="produto-img">
                                            @if (produto.MaisVendido)
                                            {
                                                <span class="selo-mais-vendido">
                                                    Mais vendido
                                                </span>
                                            }

                                            @if (!string.IsNullOrEmpty(produto.NomeImagem))
                                            {
                                                <img src="/uploads/produtos/@produto.NomeImagem" alt="@produto" />

                                            }
                                            else
                                            {
                                                <div class="produto-sem-imagem">
                                                    Sem imagem
                                                </div>
                                            }
                                        </div>

                                        <div class="produto-content">

                                            <span class="produto-categoria">
                                                @produto.Categoria
                                            </span>

                                            <h4>@produto.Nome</h4>

                                            <div class="produto-preco">
                                                @produto.Preco.ToString("C2")
                                                <span>/ @produto.UnidadeMedida</span>
                                            </div>

                                            <p>@produto.Descricao</p>
                                            
                                            @if (!produto.ForaDeEstoque)
                                            {
                                                <div class="controle-quantidade">
                                                    <input type="number" class="quantidade-produto" value="1" min="1" step="1"
                                                           aria-label="Quantidade de @produto.Nome" />
                                                </div>

                                                <div class="total-produto">
                                                    Total estimado:
                                                    <strong class="valor-total">
                                                        @produto.Preco.ToString("C2")
                                                    </strong>
                                                </div>
                                            }

                                            @if (produto.ForaDeEstoque)
                                            {
                                                <span class="produto-fora-estoque">
                                                    Fora de estoque
                                                </span>
                                            }
                                            else
                                            {
                                                <a asp-controller="Home" asp-action="Contact" asp-route-produto="@produto.Id"
                                                   class="btn-orcamento">
                                                    Entrar em contato
                                                </a>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>
                </div>

                <!-- Sidebar direita -->
                <div class="col-lg-4">
                    <div class="sidebar-widget">
                        <h4>Categorias</h4>
                        <ul class="list cat-list">
                            <li>
                                Construção
                                <span>(@(Model.Count(p => p.Categoria == "Construção")))</span>
                            </a>
                        </li>

                        <li>
                            Encanamento
                            <span>(@(Model.Count(p => p.Categoria == "Encanamento")))</span>
                        </a>
                    </li>

                    <li>
                        Acabamento
                        <span>(@(Model.Count(p => p.Categoria == "Acabamento")))</span>
                    </a>
                </li>

                <li>
                    Elétrica
                    <span>(@(Model.Count(p => p.Categoria == "Elétrica")))</span>
                </a>
            </li>

            <li>
                Ferramentas
                <span>(@(Model.Count(p => p.Categoria == "Ferramentas")))</span>
            </a>
        </li>
    </ul>
</div>

<div class="sidebar-widget">
    <h4>Produtos em Destaque</h4>

    @{
        var produtosDestaque = Model
            .Where(produto => produto.MaisVendido)
            .Take(3)
            .ToList();
    }

    @if (produtosDestaque.Any())
    {
        @foreach (var produto in produtosDestaque)
        {
            <div class="recent-product-item">

                <div class="recent-product-img">
                    @if (!string.IsNullOrEmpty(produto.NomeImagem))
                    {
                        <img src="/uploads/produtos/@produto.NomeImagem" alt="@produto.Nome" />

                    }
                    else
                    {
                        <span>Sem imagem</span>
                    }
                </div>

                <div class="recent-product-info">
                    <h5>@produto.Nome</h5>
                    <p>@produto.Categoria</p>
                </div>

            </div>
        }
    }
    else
    {
        <p>Nenhum produto em destaque.</p>
    }
</div>
</div>
</div>
</div>
</section>

<!-- Call to action final -->
<section class="contact-with-area contact-compact" data-background="/assets/img/gallery/section-bg2.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2 text-center">
                <h2 style="color: #fff; font-size: 32px; font-weight: 700;">
                    Ficou interessado em algum produto?
                </h2>
                <p style="color: #fff; margin: 20px 0;">
                    Entre em contato conosco e faça seu pedido. Atendemos também pelo WhatsApp.
                </p>
                <a href="/Home/Contact" class="white-btn btn-sm">Falar com consultor</a>
            </div>
        </div>
    </div>
</section>
</main>

@section Scripts {
    <script src="~/js/products.js"
            asp-append-version="true"></script>
}
        

