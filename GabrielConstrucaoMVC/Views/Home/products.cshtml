@model IEnumerable<GabrielConstrucaoMVC.Models.Produto>
@{
    ViewData["Title"] = "Produtos";
}

<style>
    .filter-bar {
        background: #f9f9f9;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 40px;
    }

    .filter-buttons .btn-filter {
        background: transparent;
        border: 1px solid #ddd;
        padding: 8px 20px;
        margin: 5px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s;
        color: #333;
    }

    .filter-buttons .btn-filter:hover,
    .filter-buttons .btn-filter.active {
        background: #ff5f13;
        border-color: #ff5f13;
        color: #fff;
    }

    .search-box {
        position: relative;
        max-width: 300px;
        margin-left: auto;
    }

    .search-box input {
        width: 100%;
        padding: 10px 20px;
        border: 1px solid #ddd;
        border-radius: 40px;
        font-size: 14px;
    }

    .search-box button {
        position: absolute;
        right: 5px;
        top: 5px;
        background: #ff5f13;
        border: none;
        border-radius: 40px;
        padding: 6px 15px;
        color: #fff;
        cursor: pointer;
    }

    .produto-categoria {
        display: inline-block;
        background: #f0f0f0;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        margin-bottom: 10px;
        color: #ff5f13;
        font-weight: 600;
    }

    .sidebar-widget {
        background: #fff;
        border: 1px solid #eee;
        padding: 25px;
        margin-bottom: 30px;
        border-radius: 8px;
    }

    .sidebar-widget h4 {
        font-size: 20px;
        margin-bottom: 20px;
        font-weight: 700;
        position: relative;
        padding-bottom: 10px;
    }

    .sidebar-widget h4:after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 40px;
        height: 2px;
        background: #ff5f13;
    }

    .cat-list li {
        margin-bottom: 12px;
    }

    .cat-list li a {
        color: #555;
        transition: 0.3s;
        display: flex;
        justify-content: space-between;
    }

    .cat-list li a:hover {
        color: #ff5f13;
        padding-left: 5px;
    }

    .recent-product-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .recent-product-img {
        width: 70px;
        min-width: 70px;
        height: 70px;
        overflow: hidden;
        border-radius: 8px;
        margin-right: 15px;
    }

    .recent-product-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .recent-product-info h5 {
        font-size: 16px;
        margin-bottom: 5px;
    }

    .recent-product-info p {
        font-size: 13px;
        color: #888;
        margin-bottom: 0;
    }

    .pagination-area {
        margin-top: 50px;
    }

    .pagination-area .page-link {
        color: #ff5f13;
        border-radius: 0;
        margin: 0 3px;
    }

    .pagination-area .page-item.active .page-link {
        background-color: #ff5f13;
        border-color: #ff5f13;
        color: #fff;
    }

    @@media (max-width: 768px) {
        .filter-bar .row>div {
            margin-bottom: 15px;
        }

        .search-box {
            margin-left: 0;
            max-width: 100%;
        }
    }
</style>

<!-- Preloader Start -->
<div id="preloader-active">
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
            <div class="preloader-circle"></div>
            <div class="preloader-img pere-text">
                <img src="/assets/img/logo/loder-logo.png" alt="">
            </div>
        </div>
    </div>
</div>
<!-- Preloader End -->

<main>
    <!-- Banner interno -->
    <div class="slider-area">
        <div class="single-slider hero-overly slider-height2 d-flex align-items-center"
             data-background="/assets/img/banner/bannerprodutos.jpeg">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-cap pt-100">
                            <h2>Nossos Produtos</h2>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item"><a href="#">Produtos</a></li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Seção de produtos com filtros -->
    <section class="products-page section-padding30">
        <div class="container">
            <!-- Filtros e busca -->
            <div class="filter-bar">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="filter-buttons">
                            <button class="btn-filter active" data-filter="all">Todos</button>
                            <button class="btn-filter" data-filter="construcao">Construção</button>
                            <button class="btn-filter" data-filter="encanamento">Encanamento</button>
                            <button class="btn-filter" data-filter="acabamento">Acabamento</button>
                            <button class="btn-filter" data-filter="eletrica">Elétrica</button>
                            <button class="btn-filter" data-filter="ferramentas">Ferramentas</button>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="search-box">
                            <input type="text" id="search-input" placeholder="Buscar produto...">
                            <button id="search-btn"><i class="ti-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Grade de produtos -->
                <div class="col-lg-8">

                    <div class="row" id="products-grid">

                        @if (!Model.Any())
                        {
                            <div class="col-12">
                                <div class="alert alert-info">
                                    Nenhum produto disponível no momento.
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var produto in Model)
                            {
                                var categoriaFiltro = produto.Categoria
                                    .Trim()
                                     .ToLowerInvariant();

                                categoriaFiltro = categoriaFiltro switch
                                {
                                    "construção" => "construcao",
                                    "encanamento" => "encanamento",
                                    "acabamento" => "acabamento",
                                    "elétrica" => "eletrica",
                                    "ferramentas" => "ferramentas",
                                    _ => categoriaFiltro
                                };

                                <div class="col-xl-6 col-lg-6 col-md-6 produto-item" data-categoria="@categoriaFiltro"
                                     data-nome="@produto.Nome.ToLower()">

                                    <div class="single-produto-card mb-30">

                                        <div class="produto-img">
                                            @if (!string.IsNullOrEmpty(produto.NomeImagem))
                                            {
                                                <img src="/uploads/produtos/@produto.NomeImagem" alt="@produto" />

                                            }
                                            else
                                            {
                                                <div class="produto-sem-imagem">
                                                    Sem imagem
                                                </div>
                                            }
                                        </div>

                                        <div class="produto-content">

                                            <span class="produto-categoria">
                                                @produto.Categoria
                                            </span>

                                            <h4>@produto.Nome</h4>

                                            <p>@produto.Descricao</p>

                                            @if (produto.ForaDeEstoque)
                                            {
                                                <span class="produto-fora-estoque">
                                                    Fora de estoque
                                                </span>
                                            }
                                            else
                                            {
                                                <a asp-controller="Home" asp-action="Contact" asp-route-produto="@produto.Id"
                                                   class="btn-orcamento">
                                                    Solicitar orçamento
                                                </a>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>
               
<!-- Sidebar direita -->
<div class="col-lg-4">
    <div class="sidebar-widget">
        <h4>Categorias</h4>
        <ul class="list cat-list">
            <li><a href="#" data-filter-cat="construcao">Construção <span>(4)</span></a></li>
            <li><a href="#" data-filter-cat="encanamento">Encanamento <span>(2)</span></a></li>
            <li><a href="#" data-filter-cat="acabamento">Acabamento <span>(3)</span></a></li>
            <li><a href="#" data-filter-cat="eletrica">Elétrica <span>(2)</span></a></li>
            <li><a href="#" data-filter-cat="ferramentas">Ferramentas <span>(2)</span></a></li>
        </ul>
    </div>

    <div class="sidebar-widget">
        <h4>Produtos em Destaque</h4>

        <div class="recent-product-item">
            <div class="recent-product-img">
                <img src="/assets/img/offers/construcaofoto.png" alt="Cimento">
            </div>
            <div class="recent-product-info">
                <h5><a href="/Home/Contact?produto=Cimento">Cimento CP-II</a></h5>
                <p>Construção</p>
            </div>
        </div>

        <div class="recent-product-item">
            <div class="recent-product-img">
                <img src="/assets/img/offers/encanamentofoto.png" alt="Tubo PVC">
            </div>
            <div class="recent-product-info">
                <h5><a href="/Home/Contact?produto=TuboPVC">Tubo PVC 100mm</a></h5>
                <p>Encanamento</p>
            </div>
        </div>

        <div class="recent-product-item">
            <div class="recent-product-img">
                <img src="/assets/img/offers/lareacabemntofoto.png" alt="Tinta">
            </div>
            <div class="recent-product-info">
                <h5><a href="/Home/Contact?produto=Tinta">Tinta Acrílica</a></h5>
                <p>Acabamento</p>
            </div>
        </div>
    </div>
</div>
</div>
</div>
</section>

<!-- Call to action final -->
<section class="contact-with-area contact-compact" data-background="/assets/img/gallery/section-bg2.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2 text-center">
                <h2 style="color: #fff; font-size: 32px; font-weight: 700;">
                    Ficou interessado em algum produto?
                </h2>
                <p style="color: #fff; margin: 20px 0;">
                    Entre em contato conosco e faça seu pedido. Atendemos também pelo WhatsApp.
                </p>
                <a href="/Home/Contact" class="white-btn btn-sm">Falar com consultor</a>
            </div>
        </div>
    </div>
</section>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-filter').click(function () {
                var filterValue = $(this).attr('data-filter');
                $('.btn-filter').removeClass('active');
                $(this).addClass('active');

                if (filterValue === 'all') {
                    $('.produto-item').show();
                } else {
                    $('.produto-item').hide();
                    $('.produto-item[data-categoria="' + filterValue + '"]').show();
                }
            });

            $('.cat-list li a').click(function (e) {
                e.preventDefault();
                var cat = $(this).data('filter-cat');

                if (cat) {
                    $('.btn-filter').removeClass('active');
                    $('.btn-filter[data-filter="' + cat + '"]').addClass('active');
                    $('.produto-item').hide();
                    $('.produto-item[data-categoria="' + cat + '"]').show();
                }
            });

            $('#search-btn').click(function () {
                performSearch();
            });

            $('#search-input').keypress(function (e) {
                if (e.which == 13) {
                    performSearch();
                }
            });

            function performSearch() {
                var term = $('#search-input').val().toLowerCase();

                if (term === '') {
                    var activeFilter = $('.btn-filter.active').data('filter');

                    if (activeFilter === 'all') {
                        $('.produto-item').show();
                    } else {
                        $('.produto-item').hide();
                        $('.produto-item[data-categoria="' + activeFilter + '"]').show();
                    }
                } else {
                    $('.produto-item').each(function () {
                        var nome = $(this).data('nome').toLowerCase();

                        if (nome.indexOf(term) !== -1) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }
            }
        });
    </script>
}

