@{
    ViewData["Title"] = "Sobre";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
    <style>
        /* Ajustes pontuais desta página (prefixo "sobre-" para não conflitar com o tema) */
        
    </style>
}

<div id="preloader-active">
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
            <div class="preloader-circle"></div>
            <div class="preloader-img pere-text">
                <img src="/assets/img/logo/loder-logo.png" alt="">
            </div>
        </div>
    </div>
</div>

<main>

    <!-- ========== BANNER ========== -->
    <div class="slider-area">
        <div class="single-slider hero-overly slider-height2 d-flex align-items-center"
             data-background="/assets/img/gallery/section-bg2.jpg">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-cap pt-100">
                            <h2>Sobre nós</h2>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item"><a href="#">Sobre</a></li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== NOSSA HISTÓRIA ========== -->
    <div class="container pt-120 pb-90">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="pr-lg-5">
                    <span class="sobre-kicker">Nossa história</span>

                    <h2 class="mt-3" style="font-size: 42px; font-weight: 800;">
                        Construindo sonhos desde 2018
                    </h2>

                    <p class="lead mt-4">
                        A Gabriel Construção nasceu em Barra Bonita com um objetivo simples:
                        ser a loja de confiança de quem constrói, reforma ou melhora o seu espaço.
                    </p>

                    <p>
                        Somos uma empresa local, de atendimento próximo, que conhece de perto as
                        necessidades de quem está com a obra em andamento: material certo, preço justo
                        e entrega no prazo. Do primeiro saco de cimento ao acabamento final, estamos
                        junto com você em cada etapa.
                    </p>

                    <ul class="sobre-destaques">
                        <li><i class="ti-check"></i><span>Materiais para obra, reforma e acabamento em um só lugar</span></li>
                        <li><i class="ti-check"></i><span>Atendimento direto com quem entende do assunto</span></li>
                        <li><i class="ti-check"></i><span>Entrega em Barra Bonita e região</span></li>
                    </ul>

                    <a href="/Home/Contact" class="btn red-btn2 mt-4">
                        Fale com a nossa equipe →
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="sobre-foto-wrap">
                    <img src="/assets/img/hero/fachadasobre1.png" alt="Fachada da loja Gabriel Construção em Barra Bonita" class="img-fluid rounded-3 shadow-lg">
                </div>
            </div>
        </div>
    </div>

    <!-- ========== MISSÃO, VISÃO E VALORES ========== -->
    <div class="gradient-bg py-90">
        <div class="container">
            <div class="section-heading">
                <h2>Nossa essência</h2>
                <p>Valores que guiam cada decisão e projeto</p>
            </div>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="mv-card">
                        <div class="icon"><i class="ti-flag-alt"></i></div>
                        <h3>Missão</h3>
                        <p>Fornecer materiais de construção de qualidade e um atendimento honesto, facilitando a realização da obra de cada cliente.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="mv-card">
                        <div class="icon"><i class="ti-eye"></i></div>
                        <h3>Visão</h3>
                        <p>Ser a principal referência em materiais de construção de Barra Bonita e região, reconhecida pela confiança e pelo bom atendimento.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="mv-card">
                        <div class="icon"><i class="ti-heart"></i></div>
                        <h3>Valores</h3>
                        <p>Transparência, respeito, compromisso com a qualidade e valorização de quem constrói conosco.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== POR QUE ESCOLHER ========== -->
    <div class="container py-90">
        <div class="section-heading">
            <span class="sobre-kicker">Diferenciais</span>
            <h2>Por que escolher a Gabriel Construção?</h2>
            <p>Tudo o que sua obra precisa, com a proximidade de uma empresa da cidade</p>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="sobre-card">
                    <div class="icon"><i class="ti-package"></i></div>
                    <h4>Variedade de produtos</h4>
                    <p>Da estrutura ao acabamento, você encontra o que precisa sem rodar a cidade toda.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="sobre-card">
                    <div class="icon"><i class="ti-truck"></i></div>
                    <h4>Entrega rápida</h4>
                    <p>Levamos o material até a sua obra, com agilidade e cuidado, em Barra Bonita e região.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="sobre-card">
                    <div class="icon"><i class="ti-headphone-alt"></i></div>
                    <h4>Atendimento de verdade</h4>
                    <p>Equipe preparada para tirar dúvidas e ajudar você a escolher o material certo.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="sobre-card">
                    <div class="icon"><i class="ti-medall"></i></div>
                    <h4>Qualidade e confiança</h4>
                    <p>Trabalhamos com produtos de qualidade e relacionamento transparente com o cliente.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== COMO FUNCIONA ========== -->
    <div class="gradient-bg py-90">
        <div class="container">
            <div class="section-heading">
                <h2>Como é comprar com a gente</h2>
                <p>Simples, rápido e sem complicação</p>
            </div>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="sobre-passo">
                        <div class="num">1</div>
                        <h4>Conte o que você precisa</h4>
                        <p>Venha à loja ou chame no WhatsApp e explique o tamanho e o tipo da sua obra ou reforma.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="sobre-passo">
                        <div class="num">2</div>
                        <h4>Receba orientação e orçamento</h4>
                        <p>Nossa equipe ajuda a definir os materiais e apresenta as melhores opções.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="sobre-passo">
                        <div class="num">3</div>
                        <h4>Retire ou receba na obra</h4>
                        <p>Você retira na loja ou agenda a entrega, e a obra segue sem atrasos.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== EQUIPE ========== -->
    <div class="container py-90">
        <div class="section-heading">
            <h2>Nossa equipe</h2>
            <p>As pessoas que estão prontas para atender você</p>
        </div>

        <div class="row">

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="team-card">
                    <div class="team-img">
                        <img src="/assets/img/team/team1.jpeg" alt="Gabriel, proprietário">
                    </div>

                    <div class="team-info">
                        <h4>Gabriel</h4>
                        <span>Proprietário</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="team-card">
                    <div class="team-img">
                        <img src="/assets/img/team/team2.jpeg" alt="Glaucia, vendedora">
                    </div>

                    <div class="team-info">
                        <h4>Glaucia</h4>
                        <span>Vendedora</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="team-card">
                    <div class="team-img">
                        <img src="/assets/img/team/team3.jpeg" alt="Valquiria, vendedora">
                    </div>

                    <div class="team-info">
                        <h4>Valquiria</h4>
                        <span>Vendedora</span>
                    </div>
                </div>
            </div>

            <!--<div class="col-lg-3 col-md-6 mb-4">
                <div class="team-card">
                    <div class="team-img">
                        <img src="/assets/img/team/team4.jpeg" alt="Wesley, entregador">
                    </div>

                    <div class="team-info">
                        <h4>Wesley</h4>
                        <span>Entregador</span>
                    </div>
                </div>
            </div>-->

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="team-card">
                    <div class="team-img">
                        <img src="/assets/img/team/team5.jpeg" alt="Natal, entregador">
                    </div>

                    <div class="team-info">
                        <h4>Natal</h4>
                        <span>Entregador</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ========== ONDE ESTAMOS ========== -->
    <div class="gradient-bg py-90">
        <div class="container">
            <div class="section-heading">
                <h2>Venha nos visitar</h2>
                <p>Estamos em Barra Bonita, prontos para receber você</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-5 col-md-6 mb-4">
                    <div class="sobre-info">
                        <p><i class="ti-location-pin"></i> Av. Arthur Balsi, nº 620 – Barra Bonita, SP</p>
                        <p><i class="ti-mobile"></i> <a href="https://wa.me/5514997354643" target="_blank" rel="noopener">(14) 99735-4643 (WhatsApp)</a></p>
                        <p><i class="ti-headphone-alt"></i> <a href="tel:+551436418970">(14) 3641-8970</a></p>
                        <p class="mb-0"><i class="ti-email"></i> <a href="mailto:gabrielconstrucao1@gmail.com">gabrielconstrucao1@gmail.com</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== CHAMADA FINAL ========== -->
    <section class="contact-with-area contact-compact" data-background="/assets/img/gallery/section-bg2.jpg">

        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2 text-center">

                    <h2 style="color: #fff; font-size: 32px;">
                        Pronto para começar sua obra?
                    </h2>

                    <p style="color: #fff; margin: 20px 0;">
                        Fale com a nossa equipe e peça seu orçamento. →
                    </p>

                    <a href="/Home/Contact" class="white-btn btn-sm">
                        Contato
                    </a>

                </div>
            </div>
        </div>
    </section>

</main>
