@{
    ViewData["Title"] = "Sobre";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}   

<div id="preloader-active">
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
            <div class="preloader-circle"></div>
            <div class="preloader-img pere-text">
                <img src="/assets/img/logo/loder-logo.png" alt="">
            </div>
        </div>
    </div>
</div>

<main>

    <div class="slider-area">
        <div class="single-slider hero-overly slider-height2 d-flex align-items-center"
             data-background="/assets/img/gallery/section-bg2.jpg">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-cap pt-100">
                            <h2>Sobre nós</h2>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item"><a href="#">Sobre</a></li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container pt-120 pb-90">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="pr-lg-5">
                    <h2 class="mt-3" style="font-size: 42px; font-weight: 800;">
                        Construindo sonhos desde 2018
                    </h2>

                    <p class="lead mt-4">
                        A Gabriel Construção nasceu da paixão por transformar espaços.
                    </p>

                    <p>
                        Hoje somos referência em Barra Bonita e região.
                    </p>

                    <a href="/Home/Contact" class="btn red-btn2 mt-3">
                        Fale com a nossa equipe →
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <img src="/assets/img/hero/fachadasobre1.png"
                     alt="Nossa equipe"
                     class="img-fluid rounded-3 shadow-lg">
            </div>
        </div>
    </div>

    <div class="gradient-bg py-90">
        <div class="container">
            <div class="section-heading">
                <h2>Nossa essência</h2>
                <p>Valores que guiam cada decisão e projeto</p>
            </div>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="mv-card">
                        <div class="icon"><i class="ti-flag-alt"></i></div>
                        <h3>Missão</h3>
                        <p>Oferecer soluções em engenharia e construção com qualidade.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="mv-card">
                        <div class="icon"><i class="ti-eye"></i></div>
                        <h3>Visão</h3>
                        <p>Ser referência regional em construção civil.</p>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <div class="mv-card">
                        <div class="icon"><i class="ti-heart"></i></div>
                        <h3>Valores</h3>
                        <p>Transparência, respeito e compromisso com qualidade.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-90">
        <div class="section-heading">
            <h2>Nossa trajetória</h2>
        </div>

        <div class="timeline-modern">

            <div class="timeline-item-modern">
                <div class="timeline-content">
                    <div class="timeline-year">2018</div>
                    <h4>Fundação da empresa</h4>
                    <p>Início das atividades.</p>
                </div>

                <div class="timeline-dot"></div>
                <div class="timeline-content invisible-placeholder"></div>
            </div>

            <div class="timeline-item-modern">
                <div class="timeline-content invisible-placeholder"></div>
                <div class="timeline-dot"></div>

                <div class="timeline-content">
                    <div class="timeline-year">2020</div>
                    <h4>Expansão regional</h4>
                    <p>Crescimento no mercado regional.</p>
                </div>
            </div>

        </div>
    </div>


    <div class="gradient-bg py-90">
        <div class="container">
            <div class="section-heading">
                <h2>Nossa equipe</h2>
            </div>

            <div class="row">

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="team-card">
                        <div class="team-img">
                            <img src="/assets/img/team/team1.jpeg" alt="Equipe">
                        </div>

                        <div class="team-info">
                            <h4>Gabriel</h4>
                            <span>Proprietário</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="team-card">
                        <div class="team-img">
                            <img src="/assets/img/team/team2.jpeg" alt="Equipe">
                        </div>

                        <div class="team-info">
                            <h4>Glaucia</h4>
                            <span>Vendedora</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="team-card">
                        <div class="team-img">
                            <img src="/assets/img/team/team3.jpeg" alt="Equipe">
                        </div>

                        <div class="team-info">
                            <h4>Valquiria</h4>
                            <span>Vendedora</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="team-card">
                        <div class="team-img">
                            <img src="/assets/img/team/team4.jpeg" alt="Equipe">
                        </div>

                        <div class="team-info">
                            <h4>Wesley</h4>
                            <span>Entregador</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="team-card">
                        <div class="team-img">
                            <img src="/assets/img/team/team5.jpeg" alt="Equipe">
                        </div>

                        <div class="team-info">
                            <h4>Natal</h4>
                            <span>Entregador</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <section class="contact-with-area contact-compact"
             data-background="/assets/img/gallery/section-bg2.jpg">

        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2 text-center">

                    <h2 style="color: #fff; font-size: 32px;">
                        Pronto para começar sua obra?
                    </h2>

                    <p style="color: #fff; margin: 20px 0;">
                        Fale com a nossa equipe. →
                    </p>

                    <a href="/Home/Contact" class="white-btn btn-sm">
                        Solicitar orçamento
                    </a>

                </div>
            </div>
        </div>
    </section>

</main>

