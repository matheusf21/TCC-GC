@{
    ViewData["Title"] = "Painel Administrativo";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@{
    var rotulosContatos =
        ViewBag.RotulosGrafico as List<string>
        ?? new List<string>();

    var valoresContatos =
        ViewBag.ValoresGrafico as List<int>
        ?? new List<int>();

    var maiorValorContatos = valoresContatos.Any()
        ? valoresContatos.Max()
        : 0;

    var quantidadeDadosContatos = Math.Min(
        rotulosContatos.Count,
        valoresContatos.Count
    );
}

<div class="pagina-dashboard">
    <div class="dashboard-layout">

        <!-- Menu lateral -->
        <aside class="dashboard-sidebar">

            <div class="dashboard-sidebar-marca">
                <h2>Gabriel Construção</h2>
                <p>Painel administrativo</p>
            </div>

            <nav class="dashboard-menu">

                <a asp-controller="Home" asp-action="Dashboard" class="dashboard-menu-link ativo">

                    <span class="dashboard-menu-icone">
                        <i class="ti-dashboard"></i>
                    </span>

                    Visão geral
                </a>

                <a asp-controller="Produtos" asp-action="Index" class="dashboard-menu-link">

                    <span class="dashboard-menu-icone">
                        <i class="ti-package"></i>
                    </span>

                    Produtos
                </a>

                <a asp-controller="Faturamento" asp-action="Cadastrar" class="dashboard-menu-link">

                    <span class="dashboard-menu-icone">
                        <i class="ti-plus"></i>
                    </span>

                    Registrar faturamento
                </a>

                <a asp-controller="Faturamento" asp-action="Index" class="dashboard-menu-link">

                    <span class="dashboard-menu-icone">
                        <i class="ti-agenda"></i>
                    </span>

                    Histórico
                </a>

                <div class="dashboard-menu-separador"></div>

                <a asp-controller="Home" asp-action="Logout" class="dashboard-menu-link sair">

                    <span class="dashboard-menu-icone">
                        <i class="ti-power-off"></i>
                    </span>

                    Sair
                </a>

            </nav>

        </aside>

        <!-- Conteúdo principal -->
        <main class="dashboard-conteudo">

            <!-- Cabeçalho -->
            <div class="dashboard-cabecalho">

                <div>
                    <h1>Visão geral</h1>

                    <p>
                        Acompanhe os contatos e o faturamento
                        registrado pela empresa.
                    </p>
                </div>

                <div class="dashboard-cabecalho-acoes">

                    <a asp-controller="Produtos" asp-action="Index" class="btn btn-outline-dark">
                        Produtos
                    </a>

                    <a asp-controller="Faturamento" asp-action="Cadastrar" class="btn btn-success">
                        Novo faturamento
                    </a>

                </div>

            </div>

            <!-- Indicadores de faturamento -->
            <div class="row">

                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="indicador-card">

                        <div class="indicador-cabecalho">
                            <h3>Faturamento hoje</h3>

                            <span class="indicador-icone verde">
                                <i class="ti-stats-up"></i>
                            </span>
                        </div>

                        <div class="indicador-valor faturamento">
                            @(Convert.ToDecimal(
                                ViewBag.FaturamentoHoje ?? 0
                            ).ToString("C2"))
                        </div>

                        <p class="indicador-descricao">
                            Valores registrados durante o dia.
                        </p>

                    </div>
                </div>

                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="indicador-card">

                        <div class="indicador-cabecalho">
                            <h3>Faturamento do mês</h3>

                            <span class="indicador-icone verde">
                                <i class="ti-calendar"></i>
                            </span>
                        </div>

                        <div class="indicador-valor faturamento">
                            @(Convert.ToDecimal(
                                ViewBag.FaturamentoMes ?? 0
                            ).ToString("C2"))
                        </div>

                        <p class="indicador-descricao">
                            Total registrado no mês atual.
                        </p>

                    </div>
                </div>

                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="indicador-card">

                        <div class="indicador-cabecalho">
                            <h3>Faturamento do ano</h3>

                            <span class="indicador-icone verde">
                                <i class="ti-bar-chart"></i>
                            </span>
                        </div>

                        <div class="indicador-valor faturamento">
                            @(Convert.ToDecimal(
                                ViewBag.FaturamentoAno ?? 0
                            ).ToString("C2"))
                        </div>

                        <p class="indicador-descricao">
                            Total registrado no ano atual.
                        </p>

                    </div>
                </div>

            </div>

            <!-- Gráfico principal de faturamento -->
            <div class="row">

                <div class="col-12 mb-4">
                    <div class="dashboard-painel">

                        <div class="dashboard-painel-cabecalho">

                            <div>
                                <h3>Faturamento</h3>

                                <p>
                                    Compare os valores registrados durante
                                    o período selecionado.
                                </p>
                            </div>

                            <div class="faturamento-filtro">

                                <label for="periodo-faturamento">
                                    Período exibido
                                </label>

                                <select id="periodo-faturamento" class="form-control">

                                    <option value="seteDias">
                                        Últimos 7 dias
                                    </option>

                                    <option value="mes">
                                        Este mês
                                    </option>

                                    <option value="ano">
                                        Este ano
                                    </option>

                                </select>

                            </div>

                        </div>

                        <div class="faturamento-total-periodo">
                            Total no período:

                            <strong id="total-faturamento-periodo">
                                R$ 0,00
                            </strong>
                        </div>

                        <div class="faturamento-canvas-container">
                            <canvas id="grafico-faturamento"></canvas>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Indicadores de contatos -->
            <div class="row">

                <div class="col-xl-4 col-md-4 mb-4">
                    <div class="indicador-card">

                        <div class="indicador-cabecalho">
                            <h3>Total de contatos</h3>

                            <span class="indicador-icone">
                                <i class="ti-comment-alt"></i>
                            </span>
                        </div>

                        <div class="indicador-valor">
                            @ViewBag.TotalContatosWhatsApp
                        </div>

                        <p class="indicador-descricao">
                            Contatos iniciados pelo site.
                        </p>

                    </div>
                </div>

                <div class="col-xl-4 col-md-4 mb-4">
                    <div class="indicador-card">

                        <div class="indicador-cabecalho">
                            <h3>Contatos hoje</h3>

                            <span class="indicador-icone">
                                <i class="ti-mobile"></i>
                            </span>
                        </div>

                        <div class="indicador-valor">
                            @ViewBag.ContatosHoje
                        </div>

                        <p class="indicador-descricao">
                            Contatos iniciados durante o dia.
                        </p>

                    </div>
                </div>

                <div class="col-xl-4 col-md-4 mb-4">
                    <div class="indicador-card">

                        <div class="indicador-cabecalho">
                            <h3>Contatos no mês</h3>

                            <span class="indicador-icone">
                                <i class="ti-calendar"></i>
                            </span>
                        </div>

                        <div class="indicador-valor">
                            @ViewBag.ContatosMes
                        </div>

                        <p class="indicador-descricao">
                            Contatos iniciados no mês atual.
                        </p>

                    </div>
                </div>

            </div>

            <!-- Gráfico de contatos e acessos rápidos -->
            <div class="row">

                <div class="col-xl-8 mb-4">
                    <div class="dashboard-painel">

                        <div class="dashboard-painel-cabecalho">

                            <div>
                                <h3>Contatos dos últimos 7 dias</h3>

                                <p>
                                    Acessos ao WhatsApp iniciados pelo site.
                                </p>
                            </div>

                        </div>

                        <div class="grafico-contatos">

                            @for (int i = 0;
                                  i < quantidadeDadosContatos;
                                  i++)
                            {
                                var valor = valoresContatos[i];

                                var altura = maiorValorContatos > 0
                                    ? valor * 100 / maiorValorContatos
                                    : 0;

                                <div class="grafico-contato-coluna">

                                    <span class="grafico-contato-valor">
                                        @valor
                                    </span>

                                    <div class="grafico-contato-area">

                                        <div class="grafico-contato-barra" style="height: @(altura)%;">
                                        </div>

                                    </div>

                                    <span class="grafico-contato-data">
                                        @rotulosContatos[i]
                                    </span>

                                </div>
                            }

                        </div>

                    </div>
                </div>

                <!-- Acessos rápidos -->
                <div class="col-xl-4 mb-4">
                    <div class="dashboard-painel">

                        <div class="dashboard-painel-cabecalho">

                            <div>
                                <h3>Acessos rápidos</h3>

                                <p>
                                    Gerencie as principais áreas.
                                </p>
                            </div>

                        </div>

                        <div class="acesso-rapido-lista">

                            <a asp-controller="Produtos" asp-action="Index" class="acesso-rapido">

                                <span class="acesso-rapido-icone">
                                    <i class="ti-package"></i>
                                </span>

                                <span>
                                    <strong>Produtos</strong>
                                    <span>Gerenciar catálogo</span>
                                </span>

                            </a>

                            <a asp-controller="Faturamento" asp-action="Cadastrar" class="acesso-rapido">

                                <span class="acesso-rapido-icone">
                                    <i class="ti-plus"></i>
                                </span>

                                <span>
                                    <strong>Novo registro</strong>
                                    <span>Registrar faturamento</span>
                                </span>

                            </a>

                            <a asp-controller="Faturamento" asp-action="Index" class="acesso-rapido">

                                <span class="acesso-rapido-icone">
                                    <i class="ti-agenda"></i>
                                </span>

                                <span>
                                    <strong>Histórico</strong>
                                    <span>Consultar lançamentos</span>
                                </span>

                            </a>

                            <a asp-controller="Home" asp-action="Index" class="acesso-rapido">

                                <span class="acesso-rapido-icone">
                                    <i class="ti-home"></i>
                                </span>

                                <span>
                                    <strong>Visualizar site</strong>
                                    <span>Abrir página inicial</span>
                                </span>

                            </a>

                        </div>

                    </div>
                </div>

            </div>

        </main>

    </div>
</div>

@section Scripts {
    @{
        var rotulosSeteDias =
            ViewBag.RotulosFaturamentoSeteDias as List<string>
            ?? new List<string>();

        var valoresSeteDias =
            ViewBag.ValoresFaturamentoSeteDias as List<decimal>
            ?? new List<decimal>();

        var rotulosMes =
            ViewBag.RotulosFaturamentoMes as List<string>
            ?? new List<string>();

        var valoresMes =
            ViewBag.ValoresFaturamentoMes as List<decimal>
            ?? new List<decimal>();

        var rotulosAno =
            ViewBag.RotulosFaturamentoAno as string[]
            ?? Array.Empty<string>();

        var valoresAno =
            ViewBag.ValoresFaturamentoAno as List<decimal>
            ?? new List<decimal>();

        var jsonRotulosSeteDias =
            System.Text.Json.JsonSerializer.Serialize(rotulosSeteDias);

        var jsonValoresSeteDias =
            System.Text.Json.JsonSerializer.Serialize(valoresSeteDias);

        var jsonRotulosMes =
            System.Text.Json.JsonSerializer.Serialize(rotulosMes);

        var jsonValoresMes =
            System.Text.Json.JsonSerializer.Serialize(valoresMes);

        var jsonRotulosAno =
            System.Text.Json.JsonSerializer.Serialize(rotulosAno);

        var jsonValoresAno =
            System.Text.Json.JsonSerializer.Serialize(valoresAno);
    }

    <script>
    window.dashboardDados = {
        seteDias: {
            rotulos: @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    rotulosSeteDias
                )
            ),
            valores: @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    valoresSeteDias
                )
            )
        },

        mes: {
            rotulos: @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    rotulosMes
                )
            ),
            valores: @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    valoresMes
                )
            )
        },

        ano: {
            rotulos: @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    rotulosAno
                )
            ),
            valores: @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    valoresAno
                )
            )
        }
    };
</script>
<script src="~/js/dashboard.js"
        asp-append-version="true"></script>
}

