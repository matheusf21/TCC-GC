@{
    ViewData["Title"] = "Painel Administrativo";
}

@section Styles {
    <style>
        .pagina-dashboard {
            padding-top: 140px;
            padding-bottom: 60px;
            min-height: 650px;
            background-color: #f7f7f7;
        }

        .dashboard-titulo {
            margin-bottom: 35px;
        }

        .dashboard-titulo h1 {
            color: #0b1c39;
        }

        .dashboard-titulo p {
            margin-bottom: 0;
            color: #666666;
        }

        .dashboard-card {
            height: 100%;
            padding: 30px;
            background-color: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 12px;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
            text-align: center;
        }

        .dashboard-card h3 {
            margin-bottom: 12px;
            font-size: 22px;
            color: #0b1c39;
        }

        .dashboard-card p {
            min-height: 48px;
            margin-bottom: 0;
            color: #666666;
        }

        .dashboard-card .btn {
            min-width: 170px;
            margin-top: 10px;
        }

        .dashboard-numero {
            margin: 15px 0;
            color: #ff5f13;
            font-size: 42px;
            font-weight: 800;
            line-height: 1;
        }

        .faturamento-valor {
            color: #198754;
            font-size: 32px;
        }

        .dashboard-grafico {
            padding: 30px;
            background-color: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 12px;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
        }

        .dashboard-grafico h3 {
            margin-bottom: 8px;
            color: #0b1c39;
            font-size: 22px;
        }

        .dashboard-grafico>p {
            margin-bottom: 30px;
            color: #666666;
        }

        .grafico-barras {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 15px;
            height: 280px;
        }

        .grafico-coluna {
            display: flex;
            flex: 1;
            flex-direction: column;
            align-items: center;
            height: 100%;
            min-width: 45px;
        }

        .grafico-valor {
            margin-bottom: 6px;
            color: #0b1c39;
            font-size: 14px;
            font-weight: 700;
        }

        .grafico-area-barra {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            width: 55px;
            height: 210px;
            background-color: #f3f3f3;
            border-radius: 8px 8px 0 0;
            overflow: hidden;
        }

        .grafico-barra {
            width: 100%;
            min-height: 3px;
            background-color: #ff5f13;
            border-radius: 8px 8px 0 0;
            transition: height 0.3s ease;
        }

        .grafico-data {
            margin-top: 8px;
            color: #666666;
            font-size: 13px;
        }

        .dashboard-acoes {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        @@media (max-width: 768px) {
            .grafico-barras {
                gap: 5px;
                overflow-x: auto;
            }

            .grafico-area-barra {
                width: 40px;
            }

            .dashboard-acoes {
                flex-direction: column;
            }

            .dashboard-acoes .btn {
                width: 100%;
            }

            .faturamento-grafico {
                padding: 30px;
                background-color: #ffffff;
                border: 1px solid #eeeeee;
                border-radius: 12px;
                box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
            }

            .faturamento-grafico-cabecalho {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 20px;
            }

            .faturamento-grafico-cabecalho h3 {
                margin-bottom: 8px;
                color: #0b1c39;
                font-size: 22px;
            }

            .faturamento-grafico-cabecalho p {
                margin-bottom: 0;
                color: #666666;
            }

            .faturamento-grafico-cabecalho label {
                display: block;
                margin-bottom: 6px;
                color: #0b1c39;
                font-weight: 600;
            }

            #periodo-faturamento {
                min-width: 180px;
            }

            .faturamento-total-periodo {
                margin-bottom: 20px;
                color: #666666;
                font-size: 15px;
            }

            .faturamento-total-periodo strong {
                color: #198754;
                font-size: 22px;
            }

            .faturamento-canvas-container {
                position: relative;
                width: 100%;
                height: 340px;
            }

            #grafico-faturamento {
                width: 100% !important;
                height: 100% !important;
            }

            @@media (max-width: 768px) {
                .faturamento-grafico-cabecalho {
                    flex-direction: column;
                    align-items: stretch;
                }

                #periodo-faturamento {
                    width: 100%;
                }
            }

            #periodo-faturamento {
                display: block !important;
                width: 100%;
            }

            #periodo-faturamento+.nice-select {
                display: none !important;
            }
        }
    </style>
}

<div class="pagina-dashboard">
    <div class="container">

        <div class="dashboard-titulo">
            <h1>Painel Administrativo</h1>

            <p>
                Gerencie os produtos, acompanhe os contatos e consulte
                o faturamento registrado pela empresa.
            </p>
        </div>

        <!-- Produtos e contatos -->
        <div class="row">

            <div class="col-md-8 mb-4">
                <div class="dashboard-card">
                    <h3>Produtos</h3>

                    <p>
                        Cadastre, edite e exclua produtos das áreas
                        de Construção e Pet.
                    </p>

                    <a asp-controller="Produtos" asp-action="Index" class="btn btn-success">
                        Administrar Produtos
                    </a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="dashboard-card">
                    <h3>Total de contatos</h3>

                    <div class="dashboard-numero">
                        @ViewBag.TotalContatosWhatsApp
                    </div>

                    <p>
                        Total de contatos iniciados pelo site
                        através do WhatsApp.
                    </p>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="dashboard-card">
                    <h3>Contatos hoje</h3>

                    <div class="dashboard-numero">
                        @ViewBag.ContatosHoje
                    </div>

                    <p>
                        Contatos iniciados pelo site durante o dia de hoje.
                    </p>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="dashboard-card">
                    <h3>Contatos neste mês</h3>

                    <div class="dashboard-numero">
                        @ViewBag.ContatosMes
                    </div>

                    <p>
                        Contatos iniciados pelo site durante o mês atual.
                    </p>
                </div>
            </div>

        </div>

        @{
            var rotulosGrafico =
                ViewBag.RotulosGrafico as List<string>
                ?? new List<string>();

            var valoresGrafico =
                ViewBag.ValoresGrafico as List<int>
                ?? new List<int>();

            var maiorValor = valoresGrafico.Any()
                ? valoresGrafico.Max()
                : 0;
        }

        <!-- Gráfico de contatos -->
        <div class="row">

            <div class="col-12 mb-4">
                <div class="dashboard-grafico">

                    <h3>Contatos iniciados nos últimos 7 dias</h3>

                    <p>
                        Quantidade de pessoas que acessaram o WhatsApp
                        através do site em cada dia.
                    </p>

                    <div class="grafico-barras">

                        @for (int i = 0; i < rotulosGrafico.Count; i++)
                        {
                            var valor = valoresGrafico[i];

                            var altura = maiorValor > 0
                                ? valor * 100 / maiorValor
                                : 0;

                            <div class="grafico-coluna">

                                <span class="grafico-valor">
                                    @valor
                                </span>

                                <div class="grafico-area-barra">
                                    <div class="grafico-barra" style="height: @(altura)%;">
                                    </div>
                                </div>

                                <span class="grafico-data">
                                    @rotulosGrafico[i]
                                </span>

                            </div>
                        }

                    </div>

                </div>
            </div>

        </div>

        <!-- Indicadores de faturamento -->
        <div class="row">

            <div class="col-md-4 mb-4">
                <div class="dashboard-card">
                    <h3>Faturamento hoje</h3>

                    <div class="dashboard-numero faturamento-valor">
                        @(Convert.ToDecimal(
                            ViewBag.FaturamentoHoje ?? 0
                        ).ToString("C2"))
                    </div>

                    <p>
                        Valores registrados durante o dia de hoje.
                    </p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="dashboard-card">
                    <h3>Faturamento neste mês</h3>

                    <div class="dashboard-numero faturamento-valor">
                        @(Convert.ToDecimal(
                            ViewBag.FaturamentoMes ?? 0
                        ).ToString("C2"))
                    </div>

                    <p>
                        Somatório dos lançamentos do mês atual.
                    </p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="dashboard-card">
                    <h3>Faturamento neste ano</h3>

                    <div class="dashboard-numero faturamento-valor">
                        @(Convert.ToDecimal(
                            ViewBag.FaturamentoAno ?? 0
                        ).ToString("C2"))
                    </div>

                    <p>
                        Somatório dos lançamentos do ano atual.
                    </p>
                </div>
            </div>

        </div>

        <!-- Gráfico de faturamento -->
        <div class="row">
            <div class="col-12 mb-4">
                <div class="faturamento-grafico">

                    <div class="faturamento-grafico-cabecalho">
                        <div>
                            <h3>Faturamento</h3>

                            <p>
                                Compare os valores registrados ao longo do período.
                            </p>
                        </div>

                        <div>
                            <label for="periodo-faturamento">
                                Período
                            </label>

                            <select id="periodo-faturamento" class="form-control">
                                <option value="seteDias">
                                    Últimos 7 dias
                                </option>

                                <option value="mes">
                                    Este mês
                                </option>

                                <option value="ano">
                                    Este ano
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="faturamento-total-periodo">
                        Total no período:
                        <strong id="total-faturamento-periodo">
                            R$ 0,00
                        </strong>
                    </div>

                    <div class="faturamento-canvas-container">
                        <canvas id="grafico-faturamento"></canvas>
                    </div>

                </div>
            </div>
        </div>

        <!-- Ações do faturamento -->
        <div class="dashboard-acoes">

            <div>
                <a asp-controller="Faturamento" asp-action="Cadastrar" class="btn btn-success">
                    Registrar faturamento
                </a>

                <a asp-controller="Faturamento" asp-action="Index" class="btn btn-primary">
                    Ver histórico
                </a>
            </div>

            <a asp-controller="Home" asp-action="Logout" class="btn btn-danger">
                Sair
            </a>

        </div>

    </div>
</div>


@section Scripts {
    @{
        var rotulosSeteDias =
            ViewBag.RotulosFaturamentoSeteDias as List<string>
            ?? new List<string>();

        var valoresSeteDias =
            ViewBag.ValoresFaturamentoSeteDias as List<decimal>
            ?? new List<decimal>();

        var rotulosMes =
            ViewBag.RotulosFaturamentoMes as List<string>
            ?? new List<string>();

        var valoresMes =
            ViewBag.ValoresFaturamentoMes as List<decimal>
            ?? new List<decimal>();

        var rotulosAno =
            ViewBag.RotulosFaturamentoAno as string[]
            ?? Array.Empty<string>();

        var valoresAno =
            ViewBag.ValoresFaturamentoAno as List<decimal>
            ?? new List<decimal>();
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const seletor =
                document.getElementById('periodo-faturamento');

            const canvas =
                document.getElementById('grafico-faturamento');

            const totalElemento =
                document.getElementById('total-faturamento-periodo');

            if (!seletor || !canvas || !totalElemento) {
                return;
            }

            const copiaNiceSelect = seletor.nextElementSibling;

            if (
                copiaNiceSelect &&
                copiaNiceSelect.classList.contains('nice-select')
            ) {
                copiaNiceSelect.remove();
            }

            seletor.style.display = 'block';

            const dadosFaturamento = {
                seteDias: {
                    rotulos: @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                            rotulosSeteDias
                                            )
                                            ),

                    valores: @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                            valoresSeteDias
                                            )
                                            )
                    },

                mes: {
                    rotulos: @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                            rotulosMes
                                            )
                                            ),

                    valores: @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                            valoresMes
                                            )
                                            )
                    },

                ano: {
                    rotulos: @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                            rotulosAno
                                            )
                                            ),

                    valores: @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                            valoresAno
                                            )
                                            )
                    }
            };

            function formatarMoeda(valor) {
                return valor.toLocaleString('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                });
            }

            function desenharGrafico(periodo) {
                const dados = dadosFaturamento[periodo];

                if (!dados) {
                    return;
                }

                const rotulos = dados.rotulos;
                const valores = dados.valores.map(Number);

                const total = valores.reduce(function (soma, valor) {
                    return soma + valor;
                }, 0);

                totalElemento.textContent = formatarMoeda(total);

                const contexto = canvas.getContext('2d');

                const largura =
                    canvas.parentElement.clientWidth;

                const altura =
                    canvas.parentElement.clientHeight;

                const proporcao =
                    window.devicePixelRatio || 1;

                canvas.width = largura * proporcao;
                canvas.height = altura * proporcao;

                canvas.style.width = largura + 'px';
                canvas.style.height = altura + 'px';

                contexto.setTransform(
                    proporcao,
                    0,
                    0,
                    proporcao,
                    0,
                    0
                );

                contexto.clearRect(
                    0,
                    0,
                    largura,
                    altura
                );

                if (rotulos.length === 0) {
                    contexto.fillStyle = '#666666';
                    contexto.font = '14px Arial';
                    contexto.textAlign = 'center';

                    contexto.fillText(
                        'Nenhum faturamento registrado no período.',
                        largura / 2,
                        altura / 2
                    );

                    return;
                }

                const margemEsquerda = 65;
                const margemDireita = 25;
                const margemSuperior = 25;
                const margemInferior = 45;

                const larguraGrafico =
                    largura - margemEsquerda - margemDireita;

                const alturaGrafico =
                    altura - margemSuperior - margemInferior;

                const maiorValor =
                    Math.max(...valores, 1);

                contexto.strokeStyle = '#e5e5e5';
                contexto.lineWidth = 1;

                for (let linha = 0; linha <= 4; linha++) {
                    const y =
                        margemSuperior +
                        (alturaGrafico / 4) * linha;

                    contexto.beginPath();

                    contexto.moveTo(
                        margemEsquerda,
                        y
                    );

                    contexto.lineTo(
                        largura - margemDireita,
                        y
                    );

                    contexto.stroke();

                    const valorLinha =
                        maiorValor -
                        (maiorValor / 4) * linha;

                    contexto.fillStyle = '#777777';
                    contexto.font = '11px Arial';
                    contexto.textAlign = 'right';

                    contexto.fillText(
                        formatarMoeda(valorLinha),
                        margemEsquerda - 8,
                        y + 4
                    );
                }

                const intervaloRotulos =
                    rotulos.length > 15
                        ? Math.ceil(rotulos.length / 10)
                        : 1;

                const pontos = valores.map(function (valor, indice) {
                    const divisor =
                        rotulos.length > 1
                            ? rotulos.length - 1
                            : 1;

                    const x =
                        margemEsquerda +
                        (larguraGrafico / divisor) * indice;

                    const y =
                        margemSuperior +
                        alturaGrafico -
                        (valor / maiorValor) * alturaGrafico;

                    return {
                        x: x,
                        y: y,
                        valor: valor
                    };
                });

                contexto.beginPath();
                contexto.strokeStyle = '#ff5f13';
                contexto.lineWidth = 3;
                contexto.lineJoin = 'round';
                contexto.lineCap = 'round';

                pontos.forEach(function (ponto, indice) {
                    if (indice === 0) {
                        contexto.moveTo(
                            ponto.x,
                            ponto.y
                        );
                    } else {
                        contexto.lineTo(
                            ponto.x,
                            ponto.y
                        );
                    }
                });

                contexto.stroke();

                pontos.forEach(function (ponto, indice) {
                    contexto.beginPath();
                    contexto.fillStyle = '#ff5f13';

                    contexto.arc(
                        ponto.x,
                        ponto.y,
                        5,
                        0,
                        Math.PI * 2
                    );

                    contexto.fill();

                    if (
                        indice % intervaloRotulos === 0 ||
                        indice === rotulos.length - 1
                    ) {
                        contexto.fillStyle = '#666666';
                        contexto.font = '11px Arial';
                        contexto.textAlign = 'center';

                        contexto.fillText(
                            rotulos[indice],
                            ponto.x,
                            altura - 18
                        );
                    }
                });
            }

            seletor.addEventListener('change', function () {
                desenharGrafico(seletor.value);
            });

            window.addEventListener('resize', function () {
                desenharGrafico(seletor.value);
            });

            desenharGrafico('seteDias');
        });
    </script>
}
