@{
    ViewData["Title"] = "Painel Administrativo";
}

@section Styles {
    <style>
        .pagina-dashboard {
            padding-top: 140px;
            padding-bottom: 60px;
            min-height: 650px;
            background-color: #f7f7f7;
        }

        .dashboard-titulo {
            margin-bottom: 35px;
        }

        .dashboard-card {
            height: 100%;
            padding: 30px;
            background-color: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 12px;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
            text-align: center;
        }

        .dashboard-card h3 {
            margin-bottom: 12px;
            font-size: 22px;
            color: #0b1c39;
        }

        .dashboard-card p {
            min-height: 48px;
            margin-bottom: 22px;
            color: #666666;
        }

        .dashboard-card .btn {
            min-width: 170px;
        }
    </style>
}

<div class="pagina-dashboard">
    <div class="container">

        <div class="dashboard-titulo">
            <h1>Painel Administrativo</h1>
            <p>Gerencie as principais informações do site.</p>
        </div>

        <div class="row">

            <div class="col-md-6 mb-4">
                <div class="dashboard-card">
                    <h3>Produtos</h3>

                    <p>
                        Cadastre, edite e exclua produtos das áreas
                        de Construção e Pet.
                    </p>

                    <a asp-controller="Produtos" asp-action="Index" class="btn btn-success">
                        Administrar Produtos
                    </a>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="dashboard-card">
                    <h3>Mensagens</h3>

                    <p>
                        Consulte as mensagens enviadas pelos visitantes
                        através da página de contato.
                    </p>

                    <a asp-controller="Home" asp-action="AdminMessages" class="btn btn-primary">
                        Ver Mensagens
                    </a>
                </div>
            </div>

        </div>

        <a asp-controller="Home" asp-action="Logout" class="btn btn-danger">
            Sair
        </a>

    </div>
</div>
