@model IEnumerable<GabrielConstrucaoMVC.Models.Produto>
@{
    ViewData["Title"] = "Área Pet";
}

<style>
    .filter-bar {
        background: #f9f9f9;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 40px;
    }

    .filter-buttons .btn-filter {
        background: transparent;
        border: 1px solid #ddd;
        padding: 8px 20px;
        margin: 5px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s;
        color: #333;
    }

    .filter-buttons .btn-filter:hover,
    .filter-buttons .btn-filter.active {
        background: #ff5f13;
        border-color: #ff5f13;
        color: #fff;
    }

    .search-box {
        position: relative;
        max-width: 300px;
        margin-left: auto;
    }

    .search-box input {
        width: 100%;
        padding: 10px 20px;
        border: 1px solid #ddd;
        border-radius: 40px;
        font-size: 14px;
    }

    .search-box button {
        position: absolute;
        right: 5px;
        top: 5px;
        background: #ff5f13;
        border: none;
        border-radius: 40px;
        padding: 6px 15px;
        color: #fff;
        cursor: pointer;
    }

    .pet-produto-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        height: 100%;
        position: relative;
    }

    .pet-produto-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    .pet-produto-img {
        overflow: hidden;
        position: relative;
    }

    .pet-produto-img img {
        width: 100%;
        height: 220px;
        object-fit: contain;
        background-color: #fff;
        padding: 12px;
        display: block;
        transition: transform 0.4s ease;
    }

    .pet-produto-card:hover .pet-produto-img img {
        transform: scale(1.05);
    }

    .pet-produto-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #ff5f13;
        color: #fff;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        z-index: 2;
    }

    .pet-produto-content {
        padding: 20px;
        text-align: center;
    }

    .pet-produto-content h4 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #0b1c39;
    }

    .pet-produto-content .preco {
        font-size: 24px;
        font-weight: 800;
        color: #ff5f13;
        margin: 10px 0;
    }

    .pet-produto-content p {
        font-size: 14px;
        color: #666;
        margin-bottom: 20px;
    }

    .btn-pet {
        display: inline-block;
        background: #ff5f13;
        color: #fff;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
        border: none;
        text-decoration: none;
    }

    .btn-pet:hover {
        background: #0b1c39;
        color: #fff;
    }

    .pet-produto-categoria {
        display: inline-block;
        background: #f0f0f0;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        margin-bottom: 10px;
        color: #ff5f13;
        font-weight: 600;
    }

    .sidebar-widget {
        background: #fff;
        border: 1px solid #eee;
        padding: 25px;
        margin-bottom: 30px;
        border-radius: 8px;
    }

    .sidebar-widget h4 {
        font-size: 20px;
        margin-bottom: 20px;
        font-weight: 700;
        position: relative;
        padding-bottom: 10px;
    }

    .sidebar-widget h4:after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 40px;
        height: 2px;
        background: #ff5f13;
    }

    .cat-list li {
        margin-bottom: 12px;
    }

    .cat-list li a {
        color: #555;
        transition: 0.3s;
        display: flex;
        justify-content: space-between;
    }

    .cat-list li a:hover {
        color: #ff5f13;
        padding-left: 5px;
    }

    .recent-product-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .recent-product-img {
        width: 70px;
        min-width: 70px;
        height: 70px;
        overflow: hidden;
        border-radius: 8px;
        margin-right: 15px;
    }

    .recent-product-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .recent-product-info h5 {
        font-size: 16px;
        margin-bottom: 5px;
    }

    .recent-product-info p {
        font-size: 13px;
        color: #888;
        margin-bottom: 0;
    }

    .pet-destaque-bg {
        background: #f9f9fc;
        border-radius: 30px;
        padding: 50px 30px;
        margin: 60px 0;
    }

    .pet-icon-feature {
        text-align: center;
        margin-bottom: 30px;
    }

    .pet-icon-feature .icon {
        font-size: 48px;
        color: #ff5f13;
        margin-bottom: 20px;
    }

    .pet-icon-feature h4 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .single-slider.hero-overly.slider-height2 {
        background-size: cover !important;
        background-position: center center !important;
        background-repeat: no-repeat;
    }

    .slider-height2 {
        min-height: 590px;
    }

    .unidade-preco {
        color: #777;
        font-size: 13px;
        font-weight: 400;
    }

    .produto-sem-imagem {
        width: 100%;
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f4f4f4;
        color: #777;
    }

    .produto-fora-estoque {
        display: inline-block;
        padding: 12px 24px;
        background-color: #dc3545;
        color: #ffffff;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
    }

    @@media (max-width: 768px) {
        .slider-height2 {
            min-height: 350px;
        }

        .filter-bar .row>div {
            margin-bottom: 15px;
        }

        .search-box {
            margin-left: 0;
            max-width: 100%;
        }

        .controle-quantidade {
            display: flex;
            justify-content: center;
            margin: 12px 0 10px;
        }

        .quantidade-produto {
            width: 75px;
            height: 36px;
            padding: 5px 8px;
            border: 1px solid #dddddd;
            border-radius: 6px;
            text-align: center;
            font-size: 15px;
            font-weight: 600;
        }

        .total-produto {
            margin-bottom: 14px;
            color: #555555;
            font-size: 14px;
        }

        .total-produto .valor-total {
            color: #ff5f13;
            font-size: 18px;
        }
    }
</style>

<!-- Preloader Start -->
<div id="preloader-active">
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
            <div class="preloader-circle"></div>
            <div class="preloader-img pere-text">
                <img src="/assets/img/logo/loder-logo.png" alt="">
            </div>
        </div>
    </div>
</div>
<!-- Preloader End -->

<main>
    <!-- Banner interno da página Pet -->
    <div class="slider-area">
        <div class="single-slider hero-overly slider-height2 d-flex align-items-center"
             data-background="/assets/img/banner/bannerpet.png">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-cap pt-100">
                            <h2>Área Pet</h2>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item"><a href="#">Área Pet</a></li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Seção de produtos pet -->
    <section class="pet-produtos section-padding30">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="contact-title" style="margin-bottom: 20px;">Produtos para seu melhor amigo</h2>
                    <p style="max-width: 700px; margin: 0 auto 50px auto;">
                        Selecionamos com cuidado os melhores itens para garantir conforto, saúde e alegria ao seu pet.
                    </p>
                </div>
            </div>

            <!-- Filtros e busca -->
            <div class="filter-bar">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="filter-buttons">
                            <button class="btn-filter active" data-filter="all">Todos</button>
                            <button class="btn-filter" data-filter="racao">Ração</button>
                            <button class="btn-filter" data-filter="acessorios">Acessórios</button>
                            <button class="btn-filter" data-filter="higiene">Higiene</button>
                            <button class="btn-filter" data-filter="brinquedos">Brinquedos</button>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="search-box">
                            <input type="text" id="search-input" placeholder="Buscar produto...">
                            <button id="search-btn"><i class="ti-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Grade de produtos -->
                <div class="col-lg-8">
                    <div class="row" id="products-grid">

                        @if (!Model.Any())
                        {
                            <div class="col-12">
                                <div class="alert alert-info">
                                    Nenhum produto Pet disponível no momento.
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var produto in Model)
                            {
                                var categoriaFiltro = produto.Categoria
                                    .Trim()
                                    .ToLowerInvariant();

                                categoriaFiltro = categoriaFiltro switch
                                {
                                    "ração" => "racao",
                                    "rações" => "racao",
                                    "acessórios" => "acessorios",
                                    "higiene" => "higiene",
                                    "brinquedos" => "brinquedos",
                                    "medicamentos" => "medicamentos",
                                    _ => categoriaFiltro
                                };

                                <div class="col-xl-6 col-lg-6 col-md-6 produto-item mb-30" data-categoria="@categoriaFiltro"
                                     data-nome="@produto.Nome.ToLowerInvariant()">

                                    <div class="pet-produto-card"
                                         data-produto-preco="@produto.Preco.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">

                                        <div class="pet-produto-img">

                                            @if (produto.MaisVendido)
                                            {
                                                <span class="pet-produto-badge">
                                                    Mais vendido
                                                </span>
                                            }

                                            @if (!string.IsNullOrEmpty(produto.NomeImagem))
                                            {
                                                <img src="/uploads/produtos/@produto.NomeImagem" alt="@produto" />
                                            }
                                            else
                                            {
                                                <div class="produto-sem-imagem">
                                                    Sem imagem
                                                </div>
                                            }

                                        </div>

                                        <div class="pet-produto-content">

                                            <span class="pet-produto-categoria">
                                                @produto.Categoria
                                            </span>

                                            <h4>@produto.Nome</h4>

                                            <div class="preco">
                                                @produto.Preco.ToString("C2")
                                                <span class="unidade-preco">
                                                    / @produto.UnidadeMedida
                                                </span>
                                            </div>

                                            <p>@produto.Descricao</p>
                                            @if (produto.ForaDeEstoque)
                                            {
                                                <span class="produto-fora-estoque">
                                                    Fora de estoque
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="controle-quantidade">
                                                    <input type="number" class="quantidade-produto" value="1" min="1" step="1"
                                                           aria-label="Quantidade de @produto.Nome" />
                                                </div>

                                                <div class="total-produto">
                                                    Total estimado:
                                                    <strong class="valor-total">
                                                        @produto.Preco.ToString("C2")
                                                    </strong>
                                                </div>

                                                <a asp-controller="Home" asp-action="Contact" class="btn-pet">
                                                    Entrar em contato
                                                </a>
                                                
                                                <a asp-controller="Home" asp-action="Contact" asp-route-produto="@produto.Id"
                                                   class="btn-orcamento">
                                                    Entrar em contato
                                                </a>
                                            }
                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                    
                
                   
                </div>

                <!-- Sidebar direita -->
                <div class="col-lg-4">
                    <div class="sidebar-widget">
                        <h4>Categorias</h4>
                        <ul class="list cat-list">
                            <li>
                                Ração
                                <span>(@(Model.Count(p => p.Categoria == "Ração")))</span>
                            </a>
                        </li>

                        <li>
                            Acessórios
                            <span>(@(Model.Count(p => p.Categoria == "Acessórios")))</span>
                        </a>
                    </li>

                    <li>

                        Higiene
                        <span>(@(Model.Count(p => p.Categoria == "Higiene")))</span>
                    </a>
                </li>

                <li>

                    Brinquedos
                    <span>(@(Model.Count(p => p.Categoria == "Brinquedos")))</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="sidebar-widget">
        <h4>Produtos em Destaque</h4>

        @{
            var produtosDestaque = Model
                .Where(produto => produto.MaisVendido)
                .Take(3)
                .ToList();
        }

        @if (produtosDestaque.Any())
        {
            @foreach (var produto in produtosDestaque)
            {
                <div class="recent-product-item">

                    <div class="recent-product-img">
                        @if (!string.IsNullOrEmpty(produto.NomeImagem))
                        {
                            <img src="/uploads/produtos/@produto.NomeImagem" alt="@produto.Nome" />
                        }
                        else
                        {
                            <span>Sem imagem</span>
                        }
                    </div>

                    <div class="recent-product-info">
                        <h5>@produto.Nome</h5>
                        <p>@produto.Preco.ToString("C2")</p>
                    </div>

                </div>
            }
        }
        else
        {
            <p>Nenhum produto em destaque.</p>
        }
    </div>
</div>
</div>
</div>
</section>

<!-- Diferenciais -->
<div class="container">
    <div class="pet-destaque-bg">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="contact-title" style="margin-bottom: 40px;">Por que escolher nossos produtos?</h2>
            </div>

            <div class="col-md-4">
                <div class="pet-icon-feature">
                    <div class="icon"><i class="ti-shield"></i></div>
                    <h4>Qualidade Garantida</h4>
                    <p>Trabalhamos somente com marcas reconhecidas e produtos testados.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pet-icon-feature">
                    <div class="icon"><i class="ti-truck"></i></div>
                    <h4>Entrega Rápida</h4>
                    <p>Enviamos para toda a região com segurança e pontualidade.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pet-icon-feature">
                    <div class="icon"><i class="ti-announcement"></i></div>
                    <h4>Suporte Especializado</h4>
                    <p>Nossa equipe tira dúvidas e ajuda na escolha do produto ideal.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call to action final -->
<section class="contact-with-area contact-compact" data-background="/assets/img/gallery/section-bg2.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2 text-center">
                <h2 style="color: #fff; font-size: 32px; font-weight: 700;">
                    Ficou interessado em algum produto?
                </h2>
                <p style="color: #fff; margin: 20px 0;">
                    Entre em contato conosco e faça seu pedido. Atendemos também pelo WhatsApp.
                </p>
                <a href="/Home/Contact" class="white-btn btn-sm">Falar com consultor</a>
            </div>
        </div>
    </div>
</section>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-filter').click(function () {
                var filterValue = $(this).attr('data-filter');
                $('.btn-filter').removeClass('active');
                $(this).addClass('active');

                if (filterValue === 'all') {
                    $('.produto-item').show();
                } else {
                    $('.produto-item').hide();
                    $('.produto-item[data-categoria="' + filterValue + '"]').show();
                }
            });

            $('.cat-list li a').click(function (e) {
                e.preventDefault();
                var cat = $(this).data('filter-cat');

                if (cat) {
                    $('.btn-filter').removeClass('active');
                    $('.btn-filter[data-filter="' + cat + '"]').addClass('active');
                    $('.produto-item').hide();
                    $('.produto-item[data-categoria="' + cat + '"]').show();
                }
            });

            $('#search-btn').click(function () {
                performSearch();
            });

            $('#search-input').keypress(function (e) {
                if (e.which == 13) {
                    performSearch();
                }
            });

            function performSearch() {
                var term = $('#search-input').val().toLowerCase();

                if (term === '') {
                    var activeFilter = $('.btn-filter.active').data('filter');

                    if (activeFilter === 'all') {
                        $('.produto-item').show();
                    } else {
                        $('.produto-item').hide();
                        $('.produto-item[data-categoria="' + activeFilter + '"]').show();
                    }
                } else {
                    $('.produto-item').each(function () {
                        var nome = $(this).data('nome').toLowerCase();

                        if (nome.indexOf(term) !== -1) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }
            }
        });

        $('.pet-produto-card').each(function () {
            const card = this;
            const campoQuantidade = card.querySelector('.quantidade-produto');
            const elementoTotal = card.querySelector('.valor-total');

            if (!campoQuantidade || !elementoTotal) {
                return;
            }

            function atualizarTotal() {
                const preco = parseFloat(card.dataset.produtoPreco);
                let quantidade = parseInt(campoQuantidade.value);

                if (isNaN(quantidade) || quantidade < 1) {
                    quantidade = 1;
                    campoQuantidade.value = 1;
                }

                const total = preco * quantidade;

                elementoTotal.textContent = total.toLocaleString('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                });
            }

            campoQuantidade.addEventListener('input', atualizarTotal);

            atualizarTotal();
        });
    </script>
}

