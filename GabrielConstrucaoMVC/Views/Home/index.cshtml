@{
    ViewData["Title"] = "Home";
}

<!-- Preloader Start -->
<div id="preloader-active">
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
            <div class="preloader-circle"></div>
            <div class="preloader-img pere-text">
                <img src="/assets/img/logo/loder-logo.png" alt="">
            </div>
        </div>
    </div>
</div>
<!-- Preloader Start -->

<main>

    <!-- slider Area Start-->
    <div class="slider-area ">
        <div class="slider-active">
            <div class="single-slider hero-overly slider-height d-flex align-items-center"
                 data-background="/assets/img/hero/fachada3.png">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-11">
                            <div class="hero__caption">
                                <div class="hero-text1"></div>
                                <h1 data-animation="fadeInUp" data-delay=".5s">Gabriel</h1>
                                <div class="stock-text" data-animation="fadeInUp" data-delay=".8s">
                                    <h2>Construção</h2>
                                    <h2>Construção</h2>
                                </div>
                                <div class="hero-text2 mt-110" data-animation="fadeInUp" datad-elay=".9s"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="single-slider hero-overly slider-height d-flex align-items-center"
                 data-background="/assets/img/hero/h1_her">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-11">
                            <div class="hero__caption">
                                <div class="hero-text1">
                                    <span data-animation="fadeInUp" data-delay=".3s">Construção e reformas de
                                        qualidade</span>
                                    </div>
                                    <h1 data-animation="fadeInUp" data-delay=".5s">Gabriel</h1>
                                    <div class="stock-text" data-animation="fadeInUp" data-delay=".8s">
                                        <h2>Construção</h2>
                                        <h2>Construção</h2>
                                    </div>
                                    <div class="hero-text2 mt-110" data-animation="fadeInUp" data-delay=".9s">
                                        <span>Nossos Serviços</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- slider Area End-->

        <!-- Services Area Start -->
        <div class="services-area1 section-padding30">
            <div class="container">
                <!-- section tittle -->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="section-tittle mb-55">
                            <div class="front-text">
                                <h2 class="">Serviços</h2>
                            </div>
                            <span class="back-text">Serviços</span>
                        </div>
                    </div>
                </div>

                <!-- Grade de Serviços -->
                <div class="row justify-content-center">
                    <!-- Serviço 1 -->
                    <div class="col-xl-4 col-lg-4 col-md-6 mb-30">
                        <div class="single-service-card">
                            <div class="service-img">
                                <img src="/assets/img/service/services1.png" alt="Terraplanagem">
                            </div>
                            <div class="service-content">
                                <h4>Terraplanagem</h4>
                                <p>Terraplanagem completa para obras de infraestrutura, pavimentação e edificações.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Serviço 2 -->
                    <div class="col-xl-4 col-lg-4 col-md-6 mb-30">
                        <div class="single-service-card">
                            <div class="service-img">
                                <img src="/assets/img/service/servicess2.png" alt="Aluguel de andaimes">
                            </div>
                            <div class="service-content">
                                <h4>Aluguel de andaimes</h4>
                                <p>Aluguel de andaimes para obras de construção civil.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Serviço 3 -->
                    <div class="col-xl-4 col-lg-4 col-md-6 mb-30">
                        <div class="single-service-card">
                            <div class="service-img">
                                <img src="/assets/img/service/services3.jpeg" alt="Venda de produtos">
                            </div>
                            <div class="service-content">
                                <h4>Venda de produtos</h4>
                                <p>Venda de materiais e equipamentos para obras de construção civil.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <!-- Services Area End -->

        <!-- About Area Start -->
        <section class="support-company-area fix pt-10">
            <div class="support-wrapper align-items-end">
                <div class="left-content">
                    <div class="section-tittle section-tittle2 mb-55">
                        <div class="front-text">
                            <h2 class="">Quem somos</h2>
                        </div>
                        <span class="back-text">Sobre nós</span>
                    </div>
                    <div class="support-caption">
                        <p class="pera-top">Na Gabriel Construção, oferecemos soluções completas em engenharia e
                            construção civil, com foco em qualidade e inovação. Nossa equipe está pronta para realizar
                            seu projeto com excelência.</p>
                            <p>Com anos de experiência no mercado, atuamos em obras residenciais, comerciais e industriais,
                                sempre com compromisso e transparência. Conte com a gente para transformar seus planos em
                                realidade.</p>
                                <a href="/Home/About" class="btn red-btn2">Leia mais</a>
                            </div>
                        </div>
                        <div class="right-content">
                            <div class="right-img">
                                <img src="/assets/img/hero/fachadasobre1.png" alt="">
                            </div>
                            <div class="support-img-cap text-center">
                                <span>2018</span>
                                <p>Desde</p>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- About Area End -->

                <!-- Produtos em Destaque Start -->
                <section class="produtos-destaque-area section-padding30">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="section-tittle mb-55">
                                    <div class="front-text">
                                        <h2 class="">Produtos em Destaque</h2>
                                    </div>
                                    <span class="back-text">Destaques</span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Produto 1 -->
                            <div class="col-xl-4 col-lg-4 col-md-6">
                                <div class="single-produto-card mb-30">
                                    <div class="produto-img">
                                        <img src="/assets/img/offers/construcaofoto.png" alt="Construção">
                                    </div>
                                    <div class="produto-content">
                                        <h4>Construção</h4>
                                        <p>Materiais e soluções para obras residenciais e comerciais, do alicerce ao acabamento.
                                        </p>
                                        <a href="/Home/Contact?produto=Construção" class="btn-orcamento">Solicitar orçamento</a>
                                    </div>
                                </div>
                            </div>
                            <!-- Produto 2 -->
                            <div class="col-xl-4 col-lg-4 col-md-6">
                                <div class="single-produto-card mb-30">
                                    <div class="produto-img">
                                        <img src="/assets/img/offers/encanamentofoto.png" alt="Encanamento">
                                    </div>
                                    <div class="produto-content">
                                        <h4>Encanamento</h4>
                                        <p>Tubos, conexões e registros para sistemas hidráulicos residenciais e comerciais.</p>
                                        <a href="/Home/Contact?produto=Encanamento" class="btn-orcamento">Solicitar orçamento</a>
                                    </div>
                                </div>
                            </div>
                            <!-- Produto 3 -->
                            <div class="col-xl-4 col-lg-4 col-md-6">
                                <div class="single-produto-card mb-30">
                                    <div class="produto-img">
                                        <img src="/assets/img/offers/lareacabemntofoto.png" alt="Tintas">
                                    </div>
                                    <div class="produto-content">
                                        <h4>Lar e acabamento</h4>
                                        <p>Utensílios, ferragens e funcionalidade para o conforto no seu lar.</p>
                                        <a href="/Home/Contact?produto=LarEAcabamento" class="btn-orcamento">Solicitar orçamento</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botão Ver Todos -->
                        <div class="row">
                            <div class="col-12 text-center mt-30">
                                <a href="/Home/Products" class="btn-ver-todos">Ver todos os produtos</a>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Produtos em Destaque End -->

                <!-- contact with us Start -->
                <section class="contact-with-area contact-compact" data-background="/assets/img/gallery/section-bg2.jpg">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8 offset-lg-2 text-center">
                                <div class="contact-us-caption">
                                    <div class="section-tittle section-tittle4">
                                        <div class="front-text">
                                            <h2 class="">Fale conosco</h2>
                                        </div>
                                        <span class="back-text">Vamos conversar</span>
                                    </div>
                                    <p>Entre em contato para orçamentos, dúvidas ou parcerias.</p>
                                    <a href="/Home/Contact" class="white-btn btn-sm">contato</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- contact with us End-->
            </main>
