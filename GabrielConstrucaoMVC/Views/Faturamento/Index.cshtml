@model IEnumerable<GabrielConstrucaoMVC.Models.RegistroFaturamento>

@{
    ViewData["Title"] = "Histórico de Faturamento";
}

@section Styles {
    <link rel="stylesheet" href="~/css/faturamento.css" />
}

<div class="pagina-faturamento">
    <div class="container">

        <div class="faturamento-cabecalho">
            <div>
                <h1>Histórico de Faturamento</h1>

                <p>
                    Consulte os valores registrados pela empresa.
                </p>
            </div>

            <a asp-controller="Faturamento" asp-action="Cadastrar" class="btn btn-success">
                Registrar faturamento
            </a>
        </div>

        <div class="faturamento-tabela">

            @if (!Model.Any())
            {
                <div class="alert alert-info sem-registros">
                    Nenhum faturamento registrado.
                </div>
            }
            else
            {
                <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Data e hora</th>
                            <th>Valor</th>
                            <th>Forma de pagamento</th>
                            <th>Descrição</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var registro in Model)
                        {
                            <tr>
                                <td>
                                    @registro.DataRegistro.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="valor-faturamento">
                                    @registro.Valor.ToString("C2")
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(registro.FormaPagamento)
                                        ? "Não informada"
                                        : registro.FormaPagamento)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(registro.Descricao)
                                        ? "Sem descrição"
                                        : registro.Descricao)
                                </td>
                            </tr>

                            <td>
                                <div class="acoes-faturamento">
                                    <a asp-controller="Faturamento" asp-action="Editar" asp-route-id="@registro.Id"
                                       class="botao-faturamento botao-editar">
                                        Editar
                                    </a>

                                    <form asp-controller="Faturamento" asp-action="Excluir" asp-route-id="@registro.Id"
                                          method="post">

                                        <button type="submit" class="botao-faturamento botao-excluir"
                                                onclick="return confirm('Deseja realmente excluir este lançamento?');">
                                            Excluir
                                        </button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tbody>
                </table>
                </div>
            }

        </div>

        <div class="mt-3">
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary">
                Voltar ao Dashboard
            </a>
        </div>

    </div>
</div>