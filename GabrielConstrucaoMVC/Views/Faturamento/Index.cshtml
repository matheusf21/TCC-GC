@model IEnumerable<GabrielConstrucaoMVC.Models.RegistroFaturamento>

@{
    ViewData["Title"] = "Histórico de Faturamento";
}

@section Styles {
    <style>
        .pagina-faturamento {
            padding-top: 140px;
            padding-bottom: 60px;
            min-height: 650px;
            background-color: #f7f7f7;
        }

        .faturamento-cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .faturamento-cabecalho h1 {
            margin-bottom: 6px;
            color: #0b1c39;
        }

        .faturamento-cabecalho p {
            margin-bottom: 0;
            color: #666666;
        }

        .faturamento-tabela {
            overflow-x: auto;
            padding: 20px;
            background-color: #ffffff;
            border: 1px solid #eeeeee;
            border-radius: 12px;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
        }

        .faturamento-tabela table {
            margin-bottom: 0;
        }

        .valor-faturamento {
            color: #198754;
            font-weight: 700;
        }

        .sem-registros {
            padding: 25px;
            margin-bottom: 0;
            text-align: center;
        }

        .acoes-faturamento {
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .acoes-faturamento form {
            margin: 0;
        }

        .botao-faturamento {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 14px;
            border: none;
            border-radius: 4px;
            color: #ffffff !important;
            font-size: 13px;
            line-height: 1.2;
            text-decoration: none !important;
            cursor: pointer;
        }

        .botao-editar {
            background-color: #f0ad4e;
        }

        .botao-editar:hover {
            background-color: #d99632;
        }

        .botao-excluir {
            background-color: #dc3545;
        }

        .botao-excluir:hover {
            background-color: #bb2d3b;
        }
    </style>
}

<div class="pagina-faturamento">
    <div class="container">

        <div class="faturamento-cabecalho">
            <div>
                <h1>Histórico de Faturamento</h1>

                <p>
                    Consulte os valores registrados pela empresa.
                </p>
            </div>

            <a asp-controller="Faturamento" asp-action="Cadastrar" class="btn btn-success">
                Registrar faturamento
            </a>
        </div>

        <div class="faturamento-tabela">

            @if (!Model.Any())
            {
                <div class="alert alert-info sem-registros">
                    Nenhum faturamento registrado.
                </div>
            }
            else
            {
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Data e hora</th>
                            <th>Valor</th>
                            <th>Forma de pagamento</th>
                            <th>Descrição</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var registro in Model)
                        {
                            <tr>
                                <td>
                                    @registro.DataRegistro.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="valor-faturamento">
                                    @registro.Valor.ToString("C2")
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(registro.FormaPagamento)
                                        ? "Não informada"
                                        : registro.FormaPagamento)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(registro.Descricao)
                                        ? "Sem descrição"
                                        : registro.Descricao)
                                </td>
                            </tr>

                            <td>
                                <div class="acoes-faturamento">
                                    <a asp-controller="Faturamento" asp-action="Editar" asp-route-id="@registro.Id"
                                       class="botao-faturamento botao-editar">
                                        Editar
                                    </a>

                                    <form asp-controller="Faturamento" asp-action="Excluir" asp-route-id="@registro.Id"
                                          method="post">

                                        <button type="submit" class="botao-faturamento botao-excluir"
                                                onclick="return confirm('Deseja realmente excluir este lançamento?');">
                                            Excluir
                                        </button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tbody>
                </table>
            }

        </div>

        <div class="mt-3">
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary">
                Voltar ao Dashboard
            </a>
        </div>

    </div>
</div>