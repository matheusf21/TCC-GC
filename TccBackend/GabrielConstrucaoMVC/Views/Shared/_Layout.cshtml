                                             alt="Gabriel Construção">
                                    </a>

                                    <a href="/" class="small-logo">
                                        <img src="/assets/img/logo/loder-logo.png"
                                             alt="Gabriel Construção">
                                    </a>

                                </div>

                            </div>

                            <!-- Menu -->
                            <div class="col-xl-8 col-lg-8 col-md-8">

                                <div class="main-menu f-right d-none d-lg-block">

                                    <nav>

                                        <ul id="navigation">

                                            <li>
                                                <a href="/">Home</a>
                                            </li>

                                            <li>
                                                <a href="/Home/About">Sobre</a>
                                            </li>

                                            <li>
                                                <a href="/Home/Products">Produtos</a>

                                                <ul class="submenu">

                                                    <li>
                                                        <a href="/Home/Products">
                                                            Materiais de Construção
                                                        </a>
                                                    </li>

                                                    <li>
                                                        <a href="/Home/PetArea">
                                                            Área Pet
                                                        </a>
                                                    </li>

                                                </ul>

                                            </li>

                                            <li>
                                                <a href="/Home/Services">Serviços</a>
                                            </li>

                                            <li>
                                                <a href="/Home/PetArea">
                                                    Área Pet
                                                </a>
                                            </li>

                                        </ul>

                                    </nav>

                                </div>

                            </div>

                            <!-- Botão -->
                            <div class="col-xl-2 col-lg-2 col-md-3">

                                <div class="header-right-btn f-right d-none d-lg-block">

                                    <a href="/Home/Contact"
                                       class="btn">
                                        Contato
                                    </a>

                                </div>

                            </div>

                            <!-- Mobile -->
                            <div class="col-12">
                                <div class="mobile_menu d-block d-lg-none"></div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
        <!-- Header End -->

    </header>

    @RenderBody()

    <!-- Footer Start -->
    <footer>

        <div class="footer-main">

            <div class="footer-area footer-padding">

                <div class="container">

                    <div class="row justify-content-between">

                        <!-- Logo Footer -->
                        <div class="col-lg-4 col-md-4 col-sm-8">

                            <div class="single-footer-caption mb-30">

                                <div class="footer-logo">

                                    <a href="/">
                                        <img src="/assets/img/logo/logo2_footer.png"
                                             alt="Gabriel Construção">
                                    </a>

                                </div>

                                <div class="footer-tittle">

                                    <div class="footer-pera">

                                        <p class="info1">
                                            Atuamos no setor da construção civil com excelência,
                                            oferecendo soluções personalizadas para cada cliente.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Links -->
                        <div class="col-lg-2 col-md-4 col-sm-5">

                            <div class="single-footer-caption mb-50">

                                <div class="footer-tittle">

                                    <h4>Links Rápidos</h4>

                                    <ul>

                                        <li>
                                            <a href="/Home/About">Sobre</a>
                                        </li>

                                        <li>
